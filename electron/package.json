{
  "name": "brimer-plast",
  "version": "0.1.0",
  "description": "qRT-PCR primer design using primer3-py + tnBLAST",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "archiver": "^5.3.2"
  },
  "devDependencies": {
    "electron": "33.1.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "productName": "Brimer-PLAST",
    "appId": "com.brimer-plast",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.scientific-software"
    },
    "extraResources": [
      {
        "from": "../dist/pybrimer",
        "to": "pybrimer"
      },
      {
        "from": "../dist/pybrimer.exe",
        "to": "pybrimer.exe"
      },
      {
        "from": "../dist",
        "to": ".",
        "filter": ["tntblast*"]
      }
    ]
  }
}
